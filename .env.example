# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ingredient_lens

# OpenAI (Stage 3 normalization + last-resort match fallback)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Pipeline tuning
NORMALIZATION_CONFIDENCE_THRESHOLD=0.7
FUZZY_MATCH_SCORE_THRESHOLD=85
